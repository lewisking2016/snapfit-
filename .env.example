# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Kinn API (server only; never prefix secrets with EXPO_PUBLIC_).
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://kinn:local-dev-only@127.0.0.1:5432/kinn?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379
OBJECT_STORAGE_URL=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=kinn-private
OBJECT_STORAGE_ACCESS_KEY_ID=local-dev-only
OBJECT_STORAGE_SECRET_ACCESS_KEY=local-dev-only
EMAIL_DELIVERY_URL=http://127.0.0.1:8025/send
EMAIL_DELIVERY_TOKEN=local-dev-only
EMAIL_FROM_ADDRESS=Kinn <login@localhost>
TERMS_VERSION=draft-2026-10
PRIVACY_VERSION=draft-2026-10
WEB_ORIGIN=http://localhost:3000
